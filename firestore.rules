rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && request.auth.token.email == 'lunerastore26@gmail.com' && request.auth.token.email_verified == true;}
  match /site/catalogue {
   allow read: if true;
   allow create, update, delete: if isAdmin();
  }
  match /orders/{orderId} {
   allow create: if signedIn()
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.keys().hasAll(['id','userId','date','customer','items','total','status','paymentStatus'])
    && request.resource.data.id == orderId
    && request.resource.data.customer is map
    && request.resource.data.items is list
    && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 50
    && request.resource.data.total is number
    && request.resource.data.total >= 0
    && request.resource.data.total <= 10000000;
   allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
   allow update, delete: if isAdmin();
  }
 }
}