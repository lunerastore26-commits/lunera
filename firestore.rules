rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'lunerastore26@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validOrderItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'name', 'price', 'category', 'image', 'size', 'quantity'])
        && item.keys().hasOnly(['id', 'name', 'price', 'category', 'image', 'size', 'quantity'])
        && (item.id is string || item.id is int)
        && item.name is string
        && item.name.size() > 0
        && item.name.size() <= 160
        && item.price is number
        && item.price > 0
        && item.price <= 10000000
        && item.category is string
        && item.category.size() <= 80
        && item.image is string
        && item.image.size() <= 2048
        && item.size is string
        && item.size.size() <= 40
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 20;
    }

    function validOrderItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 50
        && (items.size() <= 0 || validOrderItem(items[0]))
        && (items.size() <= 1 || validOrderItem(items[1]))
        && (items.size() <= 2 || validOrderItem(items[2]))
        && (items.size() <= 3 || validOrderItem(items[3]))
        && (items.size() <= 4 || validOrderItem(items[4]))
        && (items.size() <= 5 || validOrderItem(items[5]))
        && (items.size() <= 6 || validOrderItem(items[6]))
        && (items.size() <= 7 || validOrderItem(items[7]))
        && (items.size() <= 8 || validOrderItem(items[8]))
        && (items.size() <= 9 || validOrderItem(items[9]))
        && (items.size() <= 10 || validOrderItem(items[10]))
        && (items.size() <= 11 || validOrderItem(items[11]))
        && (items.size() <= 12 || validOrderItem(items[12]))
        && (items.size() <= 13 || validOrderItem(items[13]))
        && (items.size() <= 14 || validOrderItem(items[14]))
        && (items.size() <= 15 || validOrderItem(items[15]))
        && (items.size() <= 16 || validOrderItem(items[16]))
        && (items.size() <= 17 || validOrderItem(items[17]))
        && (items.size() <= 18 || validOrderItem(items[18]))
        && (items.size() <= 19 || validOrderItem(items[19]))
        && (items.size() <= 20 || validOrderItem(items[20]))
        && (items.size() <= 21 || validOrderItem(items[21]))
        && (items.size() <= 22 || validOrderItem(items[22]))
        && (items.size() <= 23 || validOrderItem(items[23]))
        && (items.size() <= 24 || validOrderItem(items[24]))
        && (items.size() <= 25 || validOrderItem(items[25]))
        && (items.size() <= 26 || validOrderItem(items[26]))
        && (items.size() <= 27 || validOrderItem(items[27]))
        && (items.size() <= 28 || validOrderItem(items[28]))
        && (items.size() <= 29 || validOrderItem(items[29]))
        && (items.size() <= 30 || validOrderItem(items[30]))
        && (items.size() <= 31 || validOrderItem(items[31]))
        && (items.size() <= 32 || validOrderItem(items[32]))
        && (items.size() <= 33 || validOrderItem(items[33]))
        && (items.size() <= 34 || validOrderItem(items[34]))
        && (items.size() <= 35 || validOrderItem(items[35]))
        && (items.size() <= 36 || validOrderItem(items[36]))
        && (items.size() <= 37 || validOrderItem(items[37]))
        && (items.size() <= 38 || validOrderItem(items[38]))
        && (items.size() <= 39 || validOrderItem(items[39]))
        && (items.size() <= 40 || validOrderItem(items[40]))
        && (items.size() <= 41 || validOrderItem(items[41]))
        && (items.size() <= 42 || validOrderItem(items[42]))
        && (items.size() <= 43 || validOrderItem(items[43]))
        && (items.size() <= 44 || validOrderItem(items[44]))
        && (items.size() <= 45 || validOrderItem(items[45]))
        && (items.size() <= 46 || validOrderItem(items[46]))
        && (items.size() <= 47 || validOrderItem(items[47]))
        && (items.size() <= 48 || validOrderItem(items[48]))
        && (items.size() <= 49 || validOrderItem(items[49]));
    }

    match /site/catalogue {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'id', 'userId', 'date', 'customer', 'items', 'total',
          'status', 'paymentStatus', 'paymentMethod', 'emailStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'date', 'customer', 'items', 'total',
          'status', 'paymentStatus', 'paymentMethod', 'emailStatus', 'createdAt'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.id is string
        && request.resource.data.id.matches('LUN[0-9]{8}')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasAll([
          'name', 'phone', 'email', 'address', 'city', 'state', 'pin', 'notes'
        ])
        && request.resource.data.customer.keys().hasOnly([
          'name', 'phone', 'email', 'address', 'city', 'state', 'pin', 'notes'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.matches('[0-9]{10}')
        && request.resource.data.customer.email is string
        && request.resource.data.customer.email == request.auth.token.email
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() > 0
        && request.resource.data.customer.city is string
        && request.resource.data.customer.city.size() > 0
        && request.resource.data.customer.state is string
        && request.resource.data.customer.state.size() > 0
        && request.resource.data.customer.pin is string
        && request.resource.data.customer.pin.matches('[0-9]{6}')
        && request.resource.data.customer.notes is string
        && validOrderItems(request.resource.data.items)
        && request.resource.data.total is number
        && request.resource.data.total >= 1
        && request.resource.data.total <= 10000000
        && request.resource.data.status == 'New'
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentMethod == 'Cash on Delivery (COD)'
        && request.resource.data.emailStatus == 'Pending'
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paymentStatus', 'paymentCollectedAt', 'updatedAt'])
        && request.resource.data.status in [
          'New', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'
        ]
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'Delivered'
            && request.resource.data.paymentStatus == 'Paid'
            && request.resource.data.paymentCollectedAt == request.time
          )
          ||
          (
            request.resource.data.status != 'Delivered'
            && request.resource.data.paymentStatus == resource.data.paymentStatus
            && request.resource.data.get('paymentCollectedAt', null)
              == resource.data.get('paymentCollectedAt', null)
          )
        );

      allow delete: if isAdmin();
    }
  }
}