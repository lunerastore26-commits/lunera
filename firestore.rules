rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){
   return signedIn()
    && request.auth.token.email == 'lunerastore26@gmail.com'
    && request.auth.token.email_verified == true;
  }
  match /site/catalogue {
   allow read: if true;
   allow create, update, delete: if isAdmin();
  }
  match /orders/{orderId} {
   allow create: if signedIn()
    && request.resource.data.keys().hasAll([
      'id','userId','date','customer','items','total',
      'status','paymentStatus','paymentMethod','emailStatus','createdAt'
    ])
    && request.resource.data.keys().hasOnly([
      'id','userId','date','customer','items','total',
      'status','paymentStatus','paymentMethod','emailStatus','createdAt'
    ])
    && request.resource.data.id == orderId
    && request.resource.data.id is string
    && request.resource.data.id.size() >= 6
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.date is string
    && request.resource.data.customer is map
    && request.resource.data.customer.keys().hasAll([
      'name','phone','email','address','city','state','pin','notes'
    ])
    && request.resource.data.customer.keys().hasOnly([
      'name','phone','email','address','city','state','pin','notes'
    ])
    && request.resource.data.customer.name is string
    && request.resource.data.customer.name.size() > 0
    && request.resource.data.customer.phone is string
    && request.resource.data.customer.phone.size() == 10
    && request.resource.data.customer.email is string
    && request.resource.data.customer.address is string
    && request.resource.data.customer.address.size() > 0
    && request.resource.data.customer.city is string
    && request.resource.data.customer.state is string
    && request.resource.data.customer.pin is string
    && request.resource.data.customer.pin.size() == 6
    && request.resource.data.customer.notes is string
    && request.resource.data.items is list
    && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 50
    && request.resource.data.total is number
    && request.resource.data.total >= 1
    && request.resource.data.total <= 10000000
    && request.resource.data.status == 'New'
    && request.resource.data.paymentStatus == 'Pending'
    && request.resource.data.paymentMethod == 'Cash on Delivery (COD)'
    && request.resource.data.emailStatus == 'Pending'
    && request.resource.data.createdAt == request.time;
   allow read: if isAdmin()
    || (signedIn() && resource.data.userId == request.auth.uid);
   allow update, delete: if isAdmin();
  }
 }
}